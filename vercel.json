{
    "experimentalServices": {
        "frontend": {
            "framework": "create-react-app",
            "root": "frontend",
            "routePrefix": "/",
            "installCommand": "yarn install",
            "buildCommand": "CI=false yarn run build"
        },
        "backend": {
            "root": "backend",
            "routePrefix": "/_/backend",
            "entrypoint": "server.py",
            "installCommand": "pip install -r requirements.txt"
        }
    }
}
